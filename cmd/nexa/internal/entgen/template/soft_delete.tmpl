{{ define "soft_delete" }}
{{ template "header" $ }}
import (
    "context"
    "time"
    "nexis.run/nexa/kit/entx"
    {{- $seen := dict }}
    {{- range $node := $.Nodes }}
        {{- if softDeleteField $node }}
    {{ $node.PackageAlias }} "{{ $node.Config.Package }}/{{ $node.PackageDir }}"
            {{- if $node.HasOneFieldID }}
                {{- $pkg := $node.ID.Type.PkgPath }}
                {{- if and $pkg (not (hasKey $seen $pkg)) }}
    {{ $node.ID.Type.PkgName }} "{{ $pkg }}"
                    {{- $seen = set $seen $pkg true }}
                {{- end }}
            {{- end }}
        {{- end }}
    {{- end }}
)

{{ range $node := $.Nodes }}
{{ with $field := softDeleteField $node }}
{{- $client := $node.ClientName }}
{{ if not $node.IsView }}
// SoftDelete 创建标记匹配实体为已删除的更新构造器
func (c *{{ $client }}) SoftDelete() *{{ $node.UpdateName }} {
    return c.Update().SetDeletedAt(time.Now())
}

// SoftDeleteOne 标记给定实体为已删除
func (c *{{ $client }}) SoftDeleteOne(entity *{{ $node.Name }}) *{{ $node.UpdateOneName }} {
    return c.UpdateOne(entity).SetDeletedAt(time.Now())
}

// Restore 清除匹配实体的删除时间
func (c *{{ $client }}) Restore() *{{ $node.UpdateName }} {
    return c.Update().ClearDeletedAt()
}

// RestoreOne 清除给定实体的删除时间
func (c *{{ $client }}) RestoreOne(entity *{{ $node.Name }}) *{{ $node.UpdateOneName }} {
    return c.UpdateOne(entity).ClearDeletedAt()
}

// HardDelete 永久删除匹配实体
func (c *{{ $client }}) HardDelete(ctx context.Context) (int, error) {
    return c.Delete().Exec(entx.SkipSoftDelete(ctx))
}

// HardDeleteOne 永久删除给定实体
func (c *{{ $client }}) HardDeleteOne(ctx context.Context, entity *{{ $node.Name }}) error {
    {{- if $node.HasOneFieldID }}
    return c.DeleteOne(entity).Exec(entx.SkipSoftDelete(ctx))
    {{- else }}
    count, err := c.Delete().Where(
        {{- range $id := $node.EdgeSchema.ID }}
        {{ $node.Package }}.{{ $id.StructField }}(entity.{{ $id.StructField }}),
        {{- end }}
    ).Exec(entx.SkipSoftDelete(ctx))
    if err == nil && count == 0 {
        err = &NotFoundError{label: {{ $node.Package }}.Label}
    }
    return err
    {{- end }}
}

{{ if $node.HasOneFieldID }}
// SoftDeleteOneID 根据主键标记实体为已删除
func (c *{{ $client }}) SoftDeleteOneID(id {{ $node.ID.Type }}) *{{ $node.UpdateOneName }} {
    return c.UpdateOneID(id).SetDeletedAt(time.Now())
}

// RestoreOneID 根据主键清除实体的删除时间
func (c *{{ $client }}) RestoreOneID(id {{ $node.ID.Type }}) *{{ $node.UpdateOneName }} {
    return c.UpdateOneID(id).ClearDeletedAt()
}

// HardDeleteOneID 根据主键永久删除实体
func (c *{{ $client }}) HardDeleteOneID(ctx context.Context, id {{ $node.ID.Type }}) error {
    return c.DeleteOneID(id).Exec(entx.SkipSoftDelete(ctx))
}
{{ end }}
{{ end }}

// QueryNotDeleted 创建未删除实体的查询构造器
func (c *{{ $client }}) QueryNotDeleted() *{{ $node.QueryName }} {
    return c.Query().Where({{ $node.Package }}.{{ $field.StructField }}IsNil())
}

// QueryDeleted 查询所有已删除实体
func (c *{{ $client }}) QueryDeleted(ctx context.Context) ([]*{{ $node.Name }}, error) {
    return c.Query().Where({{ $node.Package }}.{{ $field.StructField }}NotNil()).All(entx.SkipSoftDelete(ctx))
}

{{ if $node.HasOneFieldID }}
// GetNotDeleted 根据主键查询未删除实体
func (c *{{ $client }}) GetNotDeleted(ctx context.Context, id {{ $node.ID.Type }}) (*{{ $node.Name }}, error) {
    return c.QueryNotDeleted().Where({{ $node.Package }}.ID(id)).Only(ctx)
}

// GetNotDeletedX 根据主键查询未删除实体，失败时触发 panic
func (c *{{ $client }}) GetNotDeletedX(ctx context.Context, id {{ $node.ID.Type }}) *{{ $node.Name }} {
    entity, err := c.GetNotDeleted(ctx, id)
    if err != nil {
        panic(err)
    }
    return entity
}
{{ end }}
{{ end }}
{{ end }}
{{ end }}

{{ define "query/additional/soft_delete" }}
{{ with $field := softDeleteField $ }}
// SoftDeleteColumn 返回删除过滤器使用的数据库列
func (query *{{ $.QueryName }}) SoftDeleteColumn() string {
    return {{ $.Package }}.{{ $field.Constant }}
}

// WhereP 追加数据库层的查询条件
func (query *{{ $.QueryName }}) WhereP(predicates ...func(*sql.Selector)) {
    typedPredicates := make([]predicate.{{ $.Name }}, len(predicates))
    for index := range predicates {
        typedPredicates[index] = predicates[index]
    }
    query.Where(typedPredicates...)
}
{{ end }}
{{ end }}
