{{- /*gotype: nexis.run/nexa/cmd/nexa/internal/base.EchoCtxTemplateVariables*/ -}}
package {{ .Package }}

import (
	"github.com/labstack/echo/v4"
	"nexis.run/nexa/kit/rest"
)

// {{ .Name }}Context {{ .Name }} 上下文
type {{ .Name }}Context struct {
	*rest.Context
}

// New{{ .Name }}Context 创建 {{ .Name }} 上下文
func New{{ .Name }}Context(c echo.Context) *{{ .Name }}Context {
	return &{{ .Name }}Context{
		Context: rest.GetContext(c),
	}
}

// Get{{ .Name }}Context 获取 {{ .Name }} 上下文
func Get{{ .Name }}Context(c echo.Context) *{{ .Name }}Context {
	switch v := c.(type) {
	case *{{ .Name }}Context:
		return v
	default:
		return New{{ .Name }}Context(c)
	}
}

// Get{{ .Name }}ContextBindingData 获取 {{ .Name }} 上下文及绑定数据
func Get{{ .Name }}ContextBindingData[T any](c echo.Context) (*{{ .Name }}Context, *T) {
	ctx := Get{{ .Name }}Context(c)
	req := new(T)
	ctx.BindValidate(req)

	return ctx, req
}

// {{ .Name }}Middleware {{ .Name }} 上下文中间件
func {{ .Name }}Middleware() echo.MiddlewareFunc {
	return func(next echo.HandlerFunc) echo.HandlerFunc {
		return func(c echo.Context) error {
			return next(Get{{ .Name }}Context(c))
		}
	}
}
